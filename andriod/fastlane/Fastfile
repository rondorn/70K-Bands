# Fastfile for Android Release Automation

require "json"

default_platform(:android)

platform :android do

  # Paths anchored to …/andriod (parent of fastlane/). Do not Dir.chdir here — fastlane uses its
  # own chdir; a second chdir causes "conflicting chdir" and breaks relative GOOGLE_PLAY_SERVICE_ACCOUNT_JSON.
  before_all do
    @android_project_root = File.expand_path("..", __dir__)

    config_path = File.join(@android_project_root, "apps_config.json")
    UI.user_error!("apps_config.json not found at #{config_path}") unless File.exist?(config_path)

    @config = JSON.parse(File.read(config_path))
    @apps = @config["apps"].select { |app| app.fetch("enabled", true) }

    raw_key = ENV["GOOGLE_PLAY_SERVICE_ACCOUNT_JSON"].to_s.strip
    UI.user_error!("Set GOOGLE_PLAY_SERVICE_ACCOUNT_JSON in .env (path to Play service account JSON)") if raw_key.empty?

    @play_json_key = File.expand_path(raw_key, @android_project_root)
    unless File.exist?(@play_json_key)
      UI.user_error!("Service account JSON not found: #{@play_json_key}\n(.env path is relative to #{@android_project_root})")
    end

    @play_sa_email = JSON.parse(File.read(@play_json_key))["client_email"] rescue "the Play service account"
  end

  def festival_flag_for(app)
    {
      "bands70k" => "-70k",
      "mdfbands" => "-mdf",
      "mmfbands" => "-mmf"
    }[app["flavor"]]
  end

  def permission_denied?(error)
    msg = error.message.to_s
    msg.match?(/does not have permission/i) || msg.match?(/PERMISSION_DENIED/i)
  end

  def truthy?(value)
    return true if value == true
    return false if value == false || value.nil?
    %w[true 1 yes y on].include?(value.to_s.strip.downcase)
  end

  def resolve_apps(options)
    apps = @config["apps"].select { |app| app.fetch("enabled", true) }
    app_names = options[:app_names]
    if app_names && !app_names.to_s.strip.empty?
      filter_set = app_names.to_s.split(",").map(&:strip)
      apps = apps.select { |app| filter_set.include?(app["name"]) }
      UI.user_error!("No apps matched app_names filter: #{app_names}") if apps.empty?
    end
    apps
  end

  def aab_path_for(app)
    flavor = app["flavor"]
    File.join(
      @android_project_root,
      "app/build/outputs/bundle/#{flavor}Release/app-#{flavor}-release.aab"
    )
  end

  def signing_for(app)
    default_path = @config["default_keystore_path"].to_s.strip
    default_path = ENV["ANDROID_KEYSTORE_PATH"].to_s.strip if default_path.empty?
    default_alias = @config["default_key_alias"].to_s.strip
    default_alias = ENV["ANDROID_KEY_ALIAS"].to_s.strip if default_alias.empty?

    store_file = app["keystore_path"].to_s.strip
    store_file = default_path if store_file.empty?
    key_alias = app["key_alias"].to_s.strip
    key_alias = default_alias if key_alias.empty?
    store_file = File.expand_path(store_file) unless store_file.empty?

    UI.user_error!("No keystore_path for #{app['name']} (set on the app or default_keystore_path)") if store_file.empty?
    UI.user_error!("No key_alias for #{app['name']} (set on the app or default_key_alias)") if key_alias.empty?
    UI.user_error!("Keystore not found for #{app['name']}: #{store_file}") unless File.exist?(store_file)

    {
      "android.injected.signing.store.file" => store_file,
      "android.injected.signing.store.password" => ENV["ANDROID_STORE_PASSWORD"],
      "android.injected.signing.key.alias" => key_alias,
      "android.injected.signing.key.password" => ENV["ANDROID_KEY_PASSWORD"]
    }
  end

  # Shared by release_all_apps and upload_to_play_only (expects AABs already built)
  # Uploads must run serially: Play Console uses one edit session per app and fastlane is not thread-safe (Dir.chdir).
  private_lane :upload_enabled_apps_to_play do |options|
    version_code = options[:version_code]
    release_notes = options[:release_notes]
    track = options[:track] || "production"
    rollout = (options[:rollout] || "1.0").to_s
    apps = resolve_apps(options)
    failed = []

    apps.each do |app|
      puts "\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
      puts "📱 Uploading: #{app['name']}"
      puts "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

      package_name = app["package_name"]
      aab_path = aab_path_for(app)

      unless File.exist?(aab_path)
        UI.user_error!(
          "AAB not found: #{aab_path}\n" \
          "Build from #{@android_project_root}:\n" \
          "  ./gradlew bundleBands70kRelease bundleMdfbandsRelease bundleMmfbandsRelease\n" \
          "Or run ./release_full_automation.sh (build + upload)."
        )
      end

      prepare_changelogs(
        package_name: package_name,
        release_notes: release_notes,
        version_code: version_code
      )

      begin
        upload_to_play_store(
          package_name: package_name,
          track: track,
          rollout: rollout,
          aab: aab_path,
          skip_upload_images: true,
          skip_upload_screenshots: true,
          json_key: @play_json_key
        )
        puts "✓ #{app['name']} → #{track}"
      rescue => e
        UI.error("✗ #{app['name']} failed: #{e.message}")
        if permission_denied?(e)
          flag = festival_flag_for(app)
          retry_cmd = if flag
            "./upload_to_play_only.sh #{flag} #{version_code} #{track} #{rollout}"
          else
            "./upload_to_play_only.sh #{version_code} #{track} #{rollout}"
          end
          UI.error(<<~MSG)

            Play Console denied #{@play_sa_email} access to #{package_name}.
            In Play Console → Users and permissions, invite that service account
            with Admin or Release manager on #{app['name']}. If the app does not
            exist yet, create it first, then invite the account.
            After access is granted, upload without rebuilding:
              #{retry_cmd}
          MSG
        end
        failed << app["name"]
      end
    end

    if failed.empty?
      puts "\n✅ All apps uploaded successfully!"
    else
      UI.user_error!("Upload failed for: #{failed.join(', ')}")
    end
  end

  desc "Release all enabled apps to Google Play (build AABs first via release_full_automation.sh / Gradle)"
  lane :release_all_apps do |options|
    release_notes = JSON.parse(options[:release_notes_json])

    upload_enabled_apps_to_play(
      version_code: options[:version_code],
      release_notes: release_notes,
      track: options[:track] || "production",
      rollout: (options[:rollout] || "1.0").to_s,
      app_names: options[:app_names]
    )
  end

  desc "Upload existing release AABs only (no Gradle). Use to debug Play API / service account permissions."
  lane :upload_to_play_only do |options|
    release_notes = JSON.parse(options[:release_notes_json])

    upload_enabled_apps_to_play(
      version_code: options[:version_code],
      release_notes: release_notes,
      track: options[:track] || "internal",
      rollout: (options[:rollout] || "1.0").to_s,
      app_names: options[:app_names]
    )
  end
  
  # Helper to prepare changelogs (shared fastlane/metadata/android — supply default layout)
  private_lane :prepare_changelogs do |options|
    package_name = options[:package_name]
    release_notes = options[:release_notes]
    version_code = options[:version_code]
    
    language_mapping = {
      "en-US" => "en-US",
      "da" => "da-DK",
      "fi" => "fi-FI",
      "fr-FR" => "fr-FR",
      "de-DE" => "de-DE",
      "pt-BR" => "pt-BR",
      "es-MX" => "es-419",
      "es-ES" => "es-ES"
    }
    
    metadata_dir = File.join(@android_project_root, "fastlane/metadata/android")
    
    release_notes.each do |lang_code, text|
      play_store_lang = language_mapping[lang_code] || lang_code
      changelog_dir = File.join(metadata_dir, play_store_lang, "changelogs")
      FileUtils.mkdir_p(changelog_dir)
      File.write(File.join(changelog_dir, "#{version_code}.txt"), text)
    end
  end
  
  desc "Build release AABs for all apps"
  lane :build_all_apps do
    gradle(
      task: "clean"
    )
    
    @apps.each do |app|
      flavor = app["flavor"]
      signing = signing_for(app)
      puts "Building #{app['name']}..."
      puts "  signing: #{signing['android.injected.signing.store.file']} (#{signing['android.injected.signing.key.alias']})"

      gradle(
        task: "bundle",
        flavor: flavor,
        build_type: "Release",
        properties: signing
      )
      
      puts "✓ #{app['name']} built"
    end
  end
  
  desc "Download metadata from Google Play Console"
  lane :download_metadata do
    @apps.each do |app|
      supply(
        package_name: app["package_name"],
        json_key: @play_json_key,
        skip_upload_apk: true,
        skip_upload_aab: true,
        skip_upload_metadata: true,
        skip_upload_changelogs: true,
        skip_upload_images: true,
        skip_upload_screenshots: true
      )
    end
  end
  
  desc "Validate AAB files"
  lane :validate_aabs do |options|
    apps = resolve_apps(options)
    apps.each do |app|
      aab_path = aab_path_for(app)
      
      if File.exist?(aab_path)
        puts "✓ #{app['name']}: AAB exists at #{aab_path}"
        sh("jarsigner -verify -verbose -certs #{aab_path}")
      else
        UI.user_error!("AAB not found for #{app['name']} at #{aab_path}")
      end
    end
  end
  
end
